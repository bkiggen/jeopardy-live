generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Season {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(20)
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  isActive  Boolean   @default(false) @map("is_active")
  scores    SeasonScore[]

  @@map("seasons")
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  code      String   @unique @db.VarChar(8)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  players Player[]
  scores  SeasonScore[]

  @@map("teams")
}

model Player {
  id              Int     @id @default(autoincrement())
  name            String  @db.VarChar(100)
  isActive        Boolean @default(true) @map("is_active")
  prefersAllCaps  Boolean @default(true) @map("prefers_all_caps")
  teamId          Int     @map("team_id")
  team            Team    @relation(fields: [teamId], references: [id])
  scores          SeasonScore[]

  @@map("players")
}

model SeasonScore {
  id         Int    @id @default(autoincrement())
  playerId   Int    @map("player_id")
  seasonId   Int    @map("season_id")
  teamId     Int    @map("team_id")
  totalScore Int    @default(0) @map("total_score")
  player     Player @relation(fields: [playerId], references: [id])
  season     Season @relation(fields: [seasonId], references: [id])
  team       Team   @relation(fields: [teamId], references: [id])

  @@unique([playerId, seasonId, teamId])
  @@map("season_scores")
}

// Single-row table holding global runtime settings. Only one row ever exists
// (id = 1, enforced by CHECK constraint). Read at boot, written through on
// every admin update.
model AppSetting {
  id                 Int     @id @default(1)
  moneyBurningMode   Boolean @default(false) @map("money_burning_mode")
  voice              String  @default("daniel") @db.VarChar(40)
  buzzAnswerSeconds  Int     @default(10) @map("buzz_answer_seconds")
  finalAnswerSeconds Int     @default(30) @map("final_answer_seconds")

  @@map("app_settings")
}

model Clue {
  id         Int       @id @default(autoincrement())
  showNumber Int?      @map("show_number")
  airDate    DateTime? @map("air_date") @db.Date
  round      String?   @db.VarChar(50)
  category   String?   @db.VarChar(255)
  value      Int?
  question   String?
  answer     String?

  @@index([round, category])
  @@map("clues")
}
